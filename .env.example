# Copy to .env for docker compose. Generate secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TURF_SECRET=
TURF_WEBHOOK_SECRET=
# Demo mode: shows sign-in codes on screen (no SMS/email provider needed) and loads demo venues on first start.
# Turn both off before real customers use the site.
TURF_DEV_OTP=true
TURF_SEED_DEMO=true
TURF_COMMISSION_PERCENT=10
HOST_PORT=3200
